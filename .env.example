# Django
DJANGO_SECRET_KEY=replace-in-production
DJANGO_DEBUG=True

# PostgreSQL/PostGIS
POSTGRES_DB=bomberos_cotopaxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-locally
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Channels: use "memory" only for tests or controlled local development.
CHANNEL_LAYER_BACKEND=memory
# Required when CHANNEL_LAYER_BACKEND=redis. Do not commit real credentials.
REDIS_URL=redis://127.0.0.1:6379/0
